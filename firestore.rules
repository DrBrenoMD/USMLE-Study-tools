rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net Default-Deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.uid == userId &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidUserDataSync(data, userId, dataType) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.dataType == dataType &&
             data.payload is string &&
             data.payload.size() <= 950000;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false;
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId) &&
                       incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      match /data/{dataType} {
        allow get: if isOwner(userId) && isValidId(userId) && isValidId(dataType);
        allow list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(dataType) &&
                         isValidUserDataSync(incoming(), userId, dataType);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(dataType) &&
                         isValidUserDataSync(incoming(), userId, dataType) &&
                         incoming().userId == existing().userId &&
                         incoming().dataType == existing().dataType;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(dataType);
      }
    }
  }
}
