{
  "manifest_version": 3,
  "name": "Assistente de Questões por Voz + Pacer",
  "version": "1.7",
  "description": "Lê enunciados, executa Question Pacer e inclui aba flutuante integrada para gerar flashcards das questões do Q-Bank.",
  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Assistente Q-Bank & Pacer"
  }
}